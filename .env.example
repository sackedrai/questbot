# ---------------------------------------------------------------------------
# Обязательное: токен бота от @BotFather
# ---------------------------------------------------------------------------
BOT_TOKEN=

# Путь к базе данных (по умолчанию data/questbot.db)
DB_PATH=data/questbot.db

# ---------------------------------------------------------------------------
# Кто может заходить в админ-раздел бота (tg_id аккаунта).
# Несколько - через запятую: 123456789,987654321
# ---------------------------------------------------------------------------
ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# Как бот ходит в Telegram. Работает ОДИН вариант, приоритет сверху вниз.
# В GitHub Actions прямой доступ работает сам - ничего настраивать не нужно.
# ---------------------------------------------------------------------------

# 1) Свой адрес Bot API (например, зеркало на Cloudflare Worker).
API_BASE_URL=

# 2) Обычный HTTP/SOCKS5 прокси.
#    Примеры: socks5://127.0.0.1:7891   http://127.0.0.1:7890
PROXY_URL=

# 3) Туннель через локальный tg-ws-proxy (TgWsProxy, порт 1443).
#    Бот и так находит его сам по конфигу - заполнять не нужно.
TGWS_HOST=127.0.0.1
TGWS_PORT=0

# ---------------------------------------------------------------------------
# GitHub Actions (обычно не нужно заполнять вручную)
# ---------------------------------------------------------------------------

# Сколько минут работать боту в одном прогоне (0 = без ограничения)
MAX_RUN_MINUTES=0

# Самозапуск следующего прогона workflow: 1 = да, 0 = нет
DISPATCH_NEXT=0

# Не отбрасывать сообщения, пришедшие пока бот был выключен: 1 = не отбрасывать
DROP_PENDING_UPDATES=1
